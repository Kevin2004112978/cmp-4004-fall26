          {"type": "alldiff", "vars": ["A", "B", "C"]},
          {"type": "eq", "a": "A", "b": 1},
          {"type": "neq", "a": "C", "b": 2}
        ]
      },
      "gold": {"A": 1, "B": 2, "C": 3}
    },
